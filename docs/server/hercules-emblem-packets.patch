+++ b/src/map/emblem_gif.c
@@ -0,0 +1,95 @@
+#include "map/emblem_gif.h"
+#include <libgif/gif_lib.h>
+#include <stdlib.h>
+#include <string.h>
+
+struct EmblemGifInput {
+    const unsigned char *next;
+    size_t remaining;
+};
+
+static int emblem_gif_read(GifFileType *gif, GifByteType *out, int count)
+{
+    struct EmblemGifInput *input = gif->UserData;
+    if (count < 0 || (size_t)count > input->remaining)
+        return 0;
+    memcpy(out, input->next, (size_t)count);
+    input->next += count;
+    input->remaining -= count;
+    return count;
+}
+
+int emblem_gif_valid(const void *data, size_t size, int width, int height,
+                     int min_frames, int max_frames)
+{
+    struct EmblemGifInput input;
+    GifFileType *gif;
+    GifRecordType record;
+    GifByteType row[24];
+    int error, frames = 0, valid = 0, transparent = NO_TRANSPARENT_COLOR;
+    if (!data || size < 13 || size > 51200 || width != 24 || height != 24 ||
+        (memcmp(data, "GIF87a", 6) && memcmp(data, "GIF89a", 6)))
+        return 0;
+    input.next = data;
+    input.remaining = size;
+    gif = DGifOpen(&input, emblem_gif_read, &error);
+    if (!gif)
+        return 0;
+    if (gif->SWidth != width || gif->SHeight != height ||
+        (gif->SColorMap && gif->SBackGroundColor >= gif->SColorMap->ColorCount))
+        goto done;
+    while (DGifGetRecordType(gif, &record) != GIF_ERROR) {
+        if (record == TERMINATE_RECORD_TYPE) {
+            valid = frames > 0 && frames >= min_frames && input.remaining == 0;
+            break;
+        }
+        if (record == EXTENSION_RECORD_TYPE) {
+            GifByteType *block;
+            int label;
+            if (DGifGetExtension(gif, &label, &block) == GIF_ERROR)
+                goto done;
+            if (label == GRAPHICS_EXT_FUNC_CODE) {
+                GraphicsControlBlock control;
+                if (!block || block[0] != 4 ||
+                    DGifExtensionToGCB(block[0], block + 1, &control) == GIF_ERROR ||
+                    control.DisposalMode > DISPOSE_PREVIOUS)
+                    goto done;
+                transparent = control.TransparentColor;
+            }
+            while (block) {
+                if (DGifGetExtensionNext(gif, &block) == GIF_ERROR ||
+                    (label == GRAPHICS_EXT_FUNC_CODE && block))
+                    goto done;
+            }
+            if (label == PLAINTEXT_EXT_FUNC_CODE)
+                transparent = NO_TRANSPARENT_COLOR;
+        } else if (record == IMAGE_DESC_RECORD_TYPE) {
+            const GifImageDesc *image;
+            const ColorMapObject *palette;
+            int x, y;
+            if (frames >= max_frames || DGifGetImageHeader(gif) == GIF_ERROR)
+                goto done;
+            image = &gif->Image;
+            if (image->Width <= 0 || image->Height <= 0 || image->Left < 0 || image->Top < 0 ||
+                image->Width > width - image->Left || image->Height > height - image->Top)
+                goto done;
+            palette = image->ColorMap ? image->ColorMap : gif->SColorMap;
+            if (!palette || transparent >= palette->ColorCount)
+                goto done;
+            for (y = 0; y < image->Height; ++y) {
+                if (DGifGetLine(gif, row, image->Width) == GIF_ERROR)
+                    goto done;
+                for (x = 0; x < image->Width; ++x)
+                    if (row[x] >= palette->ColorCount)
+                        goto done;
+            }
+            ++frames;
+            transparent = NO_TRANSPARENT_COLOR;
+        } else {
+            goto done;
+        }
+    }
+done:
+    DGifCloseFile(gif, &error);
+    return valid;
+}
