+-- Character, party and guild names are UTF-8 bytes stored unconverted in latin1
+-- columns (connection character set latin1). Compare them byte for byte instead
+-- of with latin1_swedish_ci, which folds unrelated UTF-8 bytes together.
+-- Names become case-sensitive: 'Foo' and 'foo' are different names.
+--
+-- Each column is changed only while it is a latin1 column of the shipped type;
+-- otherwise the statement fails with an "Unknown column 'refused: ...'" error
+-- and the column is left alone. Converting a utf8mb4 column to latin1 could
+-- lose data. The sql_updates row is written only if all seven columns now use
+-- latin1_bin. Going from a case-insensitive to a binary collation cannot create
+-- duplicates, so the unique and primary keys on these columns stay valid.
+
+SET @utf8_text_sql := IF((SELECT COUNT(*) FROM `information_schema`.`COLUMNS`
+	WHERE `TABLE_SCHEMA` = DATABASE() AND `TABLE_NAME` = 'char' AND `COLUMN_NAME` = 'name'
+	AND `CHARACTER_SET_NAME` = 'latin1' AND `COLUMN_TYPE` = 'varchar(30)' AND `IS_NULLABLE` = 'NO') = 1,
+	'ALTER TABLE `char` MODIFY `name` VARCHAR(30) CHARACTER SET latin1 COLLATE latin1_bin NOT NULL DEFAULT '''' ',
+	'SELECT `refused: char.name not latin1 varchar(30) not null` FROM `char` LIMIT 0');
+PREPARE utf8_text_stmt FROM @utf8_text_sql;
+EXECUTE utf8_text_stmt;
+DEALLOCATE PREPARE utf8_text_stmt;
+
+SET @utf8_text_sql := IF((SELECT COUNT(*) FROM `information_schema`.`COLUMNS`
+	WHERE `TABLE_SCHEMA` = DATABASE() AND `TABLE_NAME` = 'party' AND `COLUMN_NAME` = 'name'
+	AND `CHARACTER_SET_NAME` = 'latin1' AND `COLUMN_TYPE` = 'varchar(24)' AND `IS_NULLABLE` = 'NO') = 1,
+	'ALTER TABLE `party` MODIFY `name` VARCHAR(24) CHARACTER SET latin1 COLLATE latin1_bin NOT NULL DEFAULT '''' ',
+	'SELECT `refused: party.name not latin1 varchar(24) not null` FROM `party` LIMIT 0');
+PREPARE utf8_text_stmt FROM @utf8_text_sql;
+EXECUTE utf8_text_stmt;
+DEALLOCATE PREPARE utf8_text_stmt;
+
+SET @utf8_text_sql := IF((SELECT COUNT(*) FROM `information_schema`.`COLUMNS`
+	WHERE `TABLE_SCHEMA` = DATABASE() AND `TABLE_NAME` = 'guild' AND `COLUMN_NAME` IN ('name', 'master')
+	AND `CHARACTER_SET_NAME` = 'latin1' AND `COLUMN_TYPE` = 'varchar(24)' AND `IS_NULLABLE` = 'NO') = 2,
+	'ALTER TABLE `guild` MODIFY `name` VARCHAR(24) CHARACTER SET latin1 COLLATE latin1_bin NOT NULL DEFAULT '''', MODIFY `master` VARCHAR(24) CHARACTER SET latin1 COLLATE latin1_bin NOT NULL DEFAULT '''' ',
+	'SELECT `refused: guild.name/master not latin1 varchar(24) not null` FROM `guild` LIMIT 0');
+PREPARE utf8_text_stmt FROM @utf8_text_sql;
+EXECUTE utf8_text_stmt;
+DEALLOCATE PREPARE utf8_text_stmt;
+
+SET @utf8_text_sql := IF((SELECT COUNT(*) FROM `information_schema`.`COLUMNS`
+	WHERE `TABLE_SCHEMA` = DATABASE() AND `TABLE_NAME` = 'guild_member' AND `COLUMN_NAME` = 'name'
+	AND `CHARACTER_SET_NAME` = 'latin1' AND `COLUMN_TYPE` = 'varchar(24)' AND `IS_NULLABLE` = 'NO') = 1,
+	'ALTER TABLE `guild_member` MODIFY `name` VARCHAR(24) CHARACTER SET latin1 COLLATE latin1_bin NOT NULL DEFAULT '''' ',
+	'SELECT `refused: guild_member.name not latin1 varchar(24) not null` FROM `guild_member` LIMIT 0');
+PREPARE utf8_text_stmt FROM @utf8_text_sql;
+EXECUTE utf8_text_stmt;
+DEALLOCATE PREPARE utf8_text_stmt;
+
+SET @utf8_text_sql := IF((SELECT COUNT(*) FROM `information_schema`.`COLUMNS`
+	WHERE `TABLE_SCHEMA` = DATABASE() AND `TABLE_NAME` = 'guild_alliance' AND `COLUMN_NAME` = 'name'
+	AND `CHARACTER_SET_NAME` = 'latin1' AND `COLUMN_TYPE` = 'varchar(24)' AND `IS_NULLABLE` = 'NO') = 1,
+	'ALTER TABLE `guild_alliance` MODIFY `name` VARCHAR(24) CHARACTER SET latin1 COLLATE latin1_bin NOT NULL DEFAULT '''' ',
+	'SELECT `refused: guild_alliance.name not latin1 varchar(24) not null` FROM `guild_alliance` LIMIT 0');
+PREPARE utf8_text_stmt FROM @utf8_text_sql;
+EXECUTE utf8_text_stmt;
+DEALLOCATE PREPARE utf8_text_stmt;
+
+SET @utf8_text_sql := IF((SELECT COUNT(*) FROM `information_schema`.`COLUMNS`
+	WHERE `TABLE_SCHEMA` = DATABASE() AND `TABLE_NAME` = 'guild_expulsion' AND `COLUMN_NAME` = 'name'
+	AND `CHARACTER_SET_NAME` = 'latin1' AND `COLUMN_TYPE` = 'varchar(24)' AND `IS_NULLABLE` = 'NO') = 1,
+	'ALTER TABLE `guild_expulsion` MODIFY `name` VARCHAR(24) CHARACTER SET latin1 COLLATE latin1_bin NOT NULL DEFAULT '''' ',
+	'SELECT `refused: guild_expulsion.name not latin1 varchar(24) not null` FROM `guild_expulsion` LIMIT 0');
+PREPARE utf8_text_stmt FROM @utf8_text_sql;
+EXECUTE utf8_text_stmt;
+DEALLOCATE PREPARE utf8_text_stmt;
+
+SET @utf8_text_sql := NULL;
+
+INSERT INTO `sql_updates` (`timestamp`)
+SELECT 1793707200 FROM DUAL
+WHERE (SELECT COUNT(*) FROM `information_schema`.`COLUMNS`
+	WHERE `TABLE_SCHEMA` = DATABASE() AND `COLLATION_NAME` = 'latin1_bin'
+	AND ((`TABLE_NAME` = 'char' AND `COLUMN_NAME` = 'name')
+	  OR (`TABLE_NAME` = 'party' AND `COLUMN_NAME` = 'name')
+	  OR (`TABLE_NAME` = 'guild' AND `COLUMN_NAME` IN ('name', 'master'))
+	  OR (`TABLE_NAME` IN ('guild_member', 'guild_alliance', 'guild_expulsion') AND `COLUMN_NAME` = 'name'))) = 7;
