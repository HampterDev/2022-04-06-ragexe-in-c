diff --git a/src/common/strlib.c b/src/common/strlib.c
index d94665409..706942d48 100644
--- a/src/common/strlib.c
+++ b/src/common/strlib.c
@@ -376,6 +376,115 @@ static size_t strlib_safestrnlen(const char *string, size_t maxlen)
 	return ( string != NULL ) ? strnlen(string, maxlen) : 0;
 }
 
+/// Length of the UTF-8 sequence that lead byte c starts, or 0 if c cannot start one.
+static int strlib_utf8_sequence_length(unsigned char c)
+{
+	if (c < 0x80)
+		return 1;
+	if (c >= 0xC2 && c <= 0xDF)
+		return 2;
+	if ((c & 0xF0) == 0xE0)
+		return 3;
+	if (c >= 0xF0 && c <= 0xF4)
+		return 4;
+	return 0;
+}
+
+/// Decodes one well-formed UTF-8 character (shortest form, no surrogates, at most U+10FFFF)
+/// from s[0..len). Returns its length in bytes, or 0 if s does not start with one.
+static int strlib_utf8_decode(const unsigned char *s, size_t len, uint32 *out_cp)
+{
+	int n, i;
+	uint32 cp;
+
+	if (len == 0)
+		return 0;
+	n = strlib_utf8_sequence_length(s[0]);
+	if (n == 0 || len < (size_t)n)
+		return 0;
+	if (n == 1) {
+		*out_cp = s[0];
+		return 1;
+	}
+	cp = s[0] & (0x7F >> n);
+	for (i = 1; i < n; i++) {
+		if ((s[i] & 0xC0) != 0x80)
+			return 0;
+		cp = (cp << 6) | (s[i] & 0x3F);
+	}
+	if ((n == 3 && cp < 0x800) || (n == 4 && (cp < 0x10000 || cp > 0x10FFFF)) || (cp >= 0xD800 && cp <= 0xDFFF))
+		return 0;
+	*out_cp = cp;
+	return n;
+}
+
+static bool strlib_utf8_is_valid_name(const char *name)
+{
+	const unsigned char *s = (const unsigned char *)name;
+	size_t len, i;
+
+	if (name == NULL || name[0] == '\0')
+		return false;
+
+	len = strlen(name);
+	for (i = 0; i < len; ) {
+		uint32 cp;
+		int n = strlib_utf8_decode(s + i, len - i, &cp);
+
+		if (n == 0)
+			return false; // not well-formed UTF-8
+		if (cp < 0x20 || (cp >= 0x7F && cp <= 0x9F))
+			return false; // C0 controls, DEL, C1 controls
+		if (cp == 0xA0 || cp == 0xAD)
+			return false; // no-break space and soft hyphen (formerly trimmed as Latin-1 bytes)
+		if (cp == 0x061C || cp == 0x200E || cp == 0x200F || (cp >= 0x202A && cp <= 0x202E) || (cp >= 0x2066 && cp <= 0x2069))
+			return false; // bidirectional controls reorder the surrounding text
+		i += n;
+	}
+	return true;
+}
+
+static size_t strlib_utf8_boundary(const char *str, size_t len)
+{
+	const unsigned char *s = (const unsigned char *)str;
+	size_t lead = len;
+	int continuation = 0;
+	int need;
+
+	if (str == NULL)
+		return 0;
+
+	// step back over at most three continuation bytes to the byte that should start the sequence
+	while (lead > 0 && continuation < 3 && (s[lead - 1] & 0xC0) == 0x80) {
+		--lead;
+		++continuation;
+	}
+	if (lead == 0)
+		return len;
+	--lead;
+	need = strlib_utf8_sequence_length(s[lead]);
+	if (need > 1 + continuation)
+		return lead; // the last character was cut short
+	return len;
+}
+
+static char *strlib_safestrncpy_utf8(char *dst, const char *src, size_t n)
+{
+	size_t len, cut;
+
+	if (n == 0)
+		return dst;
+
+	strlib_safestrncpy(dst, src, n);
+	len = strlen(dst);
+	if (len == n - 1) { // src filled the buffer and may continue past it
+		cut = strlib_utf8_boundary(dst, len);
+		if (cut < len)
+			memset(dst + cut, '\0', len - cut);
+	}
+	return dst;
+}
+
 /// Returns the line of the target position in the string.
 /// Lines start at 1.
 static int strlib_strline(const char *str, size_t pos)
@@ -1127,6 +1236,9 @@ void strlib_defaults(void)
 	strlib->safestrnlen_ = strlib_safestrnlen;
 	strlib->strline_ = strlib_strline;
 	strlib->bin2hex_ = strlib_bin2hex;
+	strlib->utf8_is_valid_name = strlib_utf8_is_valid_name;
+	strlib->utf8_boundary = strlib_utf8_boundary;
+	strlib->safestrncpy_utf8_ = strlib_safestrncpy_utf8;
 
 	StrBuf->Malloc = StringBuf_Malloc;
 	StrBuf->Init = StringBuf_Init;
