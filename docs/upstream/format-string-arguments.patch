diff --git a/tests/build_format_string_msg.bat b/tests/build_format_string_msg.bat
new file mode 100644
index 0000000..5ac43fc
--- /dev/null
+++ b/tests/build_format_string_msg.bat
@@ -0,0 +1,15 @@
