From 61939b5d89e6587eab52bcecbd666cb15c7086dc Mon Sep 17 00:00:00 2001
From: HampterDev <131729366+HampterDev@users.noreply.github.com>
Date: Tue, 3 Nov 2026 16:44:43 +0100
Subject: [PATCH] Read format-string message arguments only up to the packet
 length

game_mode_format_string_msg (ZC_FORMATSTRING_MSG) formats msg_id's
message with up to three %s arguments, NUL-terminated strings one after
another in the packet. It took the first at the start of the strings
and found the second and third with strlen, ignoring the packet length,
so an argument without a NUL was read into whatever followed the packet,
and an argument that was missing was read from past its end.

The argument bytes, up to the packet length, are now copied into a
String, which ends them with a NUL, and next_argument steps past each
NUL with memchr inside that copy. An argument that runs to the end of
the packet ends there, and those after it are empty. Well-formed packets
give the same line as before.

Validation: the new test_format_string_msg runs the extracted function
on packets followed by 'Z' bytes: three, two and one terminated or
unterminated arguments, empty and missing ones, a message without %s,
one with four (still not shown) and a 768-byte argument, which fills the
line's 0x104 bytes. 15 packets; the test fails on the previous code.
Release build without warnings.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01VaQB81YtRGLtH8zvfX7WTY
---
 src/game/system_messages.c         |  28 ++++++--
 tests/build.bat                    |   3 +
 tests/build_format_string_msg.bat  |  15 ++++
 tests/extract_format_string_msg.py |  30 ++++++++
 tests/test_format_string_msg.c     | 111 +++++++++++++++++++++++++++++
 5 files changed, 182 insertions(+), 5 deletions(-)
 create mode 100644 tests/build_format_string_msg.bat
 create mode 100644 tests/extract_format_string_msg.py
 create mode 100644 tests/test_format_string_msg.c

diff --git a/src/game/system_messages.c b/src/game/system_messages.c
index de2cb76..a4bfe72 100644
--- a/src/game/system_messages.c
+++ b/src/game/system_messages.c
@@ -132,13 +132,23 @@ struct PACKET_ZC_FORMATSTRING_MSG {
 };
 #pragma pack(pop)

+/* The argument after arg among strings that end at end: the one past arg's NUL, or end,
+   an empty string, when arg runs to the end. */
+static const char *next_argument(const char *arg, const char *end)
+{
+    const char *nul = memchr(arg, 0, (size_t)(end - arg));
+
+    return nul ? nul + 1 : end;
+}
+
 void game_mode_format_string_msg(const unsigned char *pkt)
 {
     const struct PACKET_ZC_FORMATSTRING_MSG *packet = (const struct PACKET_ZC_FORMATSTRING_MSG *)pkt;
     char line[0x105];
     const char *fmt = msg_str(packet->msg_id);
     const char *p = fmt;
-    const char *arg1, *arg2, *arg3;
+    const char *arg1, *arg2, *arg3, *end;
+    struct String strings;
     unsigned count = 0;

     while (*p != 0) {
@@ -151,7 +161,16 @@ void game_mode_format_string_msg(const unsigned char *pkt)
             p++;
     }
     memset(line, 0, sizeof line);
-    arg1 = packet->strings;
+    /* The arguments are NUL-terminated strings one after another, up to the packet
+       length. In this terminated copy an argument that runs to the end of the packet ends
+       there, and those after it are empty. */
+    string_init(&strings);
+    if (packet->length > sizeof *packet)
+        string_assign(&strings, packet->strings, packet->length - sizeof *packet);
+    arg1 = string_cstr(&strings);
+    end = arg1 + strings.size;
+    arg2 = next_argument(arg1, end);
+    arg3 = next_argument(arg2, end);
     switch (count) {
     case 0:
         _snprintf(line, 0x104, fmt);
@@ -160,18 +179,17 @@ void game_mode_format_string_msg(const unsigned char *pkt)
         _snprintf(line, 0x104, fmt, arg1);
         break;
     case 2:
-        arg2 = arg1 + strlen(arg1) + 1;
         _snprintf(line, 0x104, fmt, arg1, arg2);
         break;
     case 3:
-        arg2 = arg1 + strlen(arg1) + 1;
-        arg3 = arg2 + strlen(arg2) + 1;
         _snprintf(line, 0x104, fmt, arg1, arg2, arg3);
         break;
     default:
         sprintf(line, "unknown argment list");
+        string_free(&strings);
         return;
     }
+    string_free(&strings);
     chat(UIM_PUSH_INTO_CHAT, line, COLOUR_WHITE, 0);
 }

