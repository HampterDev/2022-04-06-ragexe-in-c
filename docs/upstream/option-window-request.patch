+if not "%errorlevel%"=="0" exit /b 1
diff --git a/tests/build_basic_info_restore.bat b/tests/build_basic_info_restore.bat
new file mode 100644
index 0000000..b93404c
--- /dev/null
+++ b/tests/build_basic_info_restore.bat
@@ -0,0 +1,15 @@
+@echo off
+setlocal
+set "ROOT=%~dp0.."
+set "OUT=%ROOT%\build\tests\basic_info_restore"
+call "%ROOT%\tools\find_vcvars.bat" || exit /b 1
+call "%VCVARS%" >nul
+python "%ROOT%\tests\extract_basic_info_restore.py" "%ROOT%" "%OUT%"
+if errorlevel 1 exit /b 1
+pushd "%OUT%" || exit /b 1
+cl /nologo /W3 /WX /we4013 /O2 /TC /std:c11 /MD /D_CRT_SECURE_NO_WARNINGS /source-charset:utf-8 /execution-charset:.949 /I"%ROOT%\src" /I"%OUT%" /I"%ROOT%\vendor\lua-5.1.4\src" /I"%ROOT%\vendor\zlib-1.2.11" /I"%ROOT%\vendor\libpng-1.6.36" /I"%ROOT%\vendor\yyjson-0.13.0" /I"%ROOT%\vendor\giflib" /I"%ROOT%\vendor\curl-7.46.0\include" "%ROOT%\tests\test_basic_info_restore.c" /Fe:test_basic_info_restore.exe
+if errorlevel 1 (popd & exit /b 1)
+test_basic_info_restore.exe
