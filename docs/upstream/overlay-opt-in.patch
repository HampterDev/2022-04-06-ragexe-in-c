+++ b/tests/build_perf_overlay.bat
@@ -0,0 +1,15 @@
+@echo off
+setlocal
+set "ROOT=%~dp0.."
+set "OUT=%ROOT%\build\tests\perf_overlay"
+call "%ROOT%\tools\find_vcvars.bat" || exit /b 1
+call "%VCVARS%" >nul
+python "%ROOT%\tests\extract_perf_overlay.py" "%ROOT%" "%OUT%"
+if errorlevel 1 exit /b 1
+pushd "%OUT%" || exit /b 1
+cl /nologo /W3 /WX /we4013 /O2 /TC /std:c11 /MD /D_CRT_SECURE_NO_WARNINGS /source-charset:utf-8 /execution-charset:.949 /I"%ROOT%\src" /I"%OUT%" /I"%ROOT%\vendor\lua-5.1.4\src" /I"%ROOT%\vendor\zlib-1.2.11" /I"%ROOT%\vendor\libpng-1.6.36" /I"%ROOT%\vendor\yyjson-0.13.0" /I"%ROOT%\vendor\giflib" /I"%ROOT%\vendor\curl-7.46.0\include" "%ROOT%\tests\test_perf_overlay.c" /Fe:test_perf_overlay.exe /link user32.lib gdi32.lib
+if errorlevel 1 (popd & exit /b 1)
