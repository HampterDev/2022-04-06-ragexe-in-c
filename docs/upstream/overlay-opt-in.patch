From 53d23a1724793885eb0b6056ac05dcfc5580cdb0 Mon Sep 17 00:00:00 2001
From: HampterDev <131729366+HampterDev@users.noreply.github.com>
Date: Tue, 3 Nov 2026 17:48:24 +0100
Subject: [PATCH] Show the frame-time overlay only with RAGEXE_OVERLAY

The frame-time overlay (diag/perf.c) started shown when RAGEXE_OVERLAY
was set, but perf_overlay_draw also toggled it whenever Scroll Lock
changed state, with or without the variable. Scroll Lock is a
screenshot key (START-066), so players who take screenshots with it got
the debug overlay on screen.

The overlay is now opt-in through the variable only. Without
RAGEXE_OVERLAY, or with it set to 0, it never appears and Scroll Lock has
no effect on it; perf_begin, perf_end, perf_frame_end and
perf_overlay_draw return at once, so nothing is timed. With
RAGEXE_OVERLAY=1 it starts shown as before, and Scroll Lock still hides
and shows it. The variable's name and meaning are unchanged. The g_perf
counters other files increment stay as they are. Scroll Lock and Print
Screen still take screenshots through ui_window_mgr_handle_key, which is
unchanged.

Validation: the new test_perf_overlay compiles diag/perf.c with
GetEnvironmentVariableA, GetKeyState and the performance counter
stubbed and the drawing calls counted. Without the variable and with
it set to 0, 40 frames with Scroll Lock toggled every five draw nothing
and read the clock no more after the first call; with it set to 1, the
overlay draws once its first half-second is in, Scroll Lock hides it and
shows it again. The screenshot case of ui_window_mgr_handle_key, run with
each setting, takes one screenshot per first press of Scroll Lock or
Print Screen. The test fails on the previous code: Scroll Lock shows the
overlay without the variable. Release build without warnings.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01VaQB81YtRGLtH8zvfX7WTY
---
 src/diag/perf.c               |  29 ++++-
 tests/build.bat               |   3 +
 tests/build_perf_overlay.bat  |  15 +++
 tests/extract_perf_overlay.py |  18 +++
 tests/test_perf_overlay.c     | 202 ++++++++++++++++++++++++++++++++++
 5 files changed, 261 insertions(+), 6 deletions(-)
 create mode 100644 tests/build_perf_overlay.bat
 create mode 100644 tests/extract_perf_overlay.py
 create mode 100644 tests/test_perf_overlay.c

diff --git a/src/diag/perf.c b/src/diag/perf.c
index 9e4bbce..5c438d8 100644
--- a/src/diag/perf.c
+++ b/src/diag/perf.c
@@ -19,7 +19,7 @@ static const char *const phase_name[PERF_N] = {
 };

 static struct {
-    int inited, shown, lastScroll;
+    int inited, enabled, shown, lastScroll;
     LARGE_INTEGER freq;
     LARGE_INTEGER t0[PERF_N];
     LONGLONG acc[PERF_N];
@@ -52,13 +52,29 @@ static LONGLONG now(void)
     return t.QuadPart;
 }

+static void init(void);
+
+/* The overlay is a developer tool and is off unless RAGEXE_OVERLAY is set to something
+   other than 0. Off, nothing is timed or drawn, and Scroll Lock, which players press
+   for screenshots, does not show it. */
+static int overlay_enabled(void)
+{
+    if (!P.inited)
+        init();
+    return P.enabled;
+}
+
 void perf_begin(int phase)
 {
+    if (!overlay_enabled())
+        return;
     QueryPerformanceCounter(&P.t0[phase]);
 }

 void perf_end(int phase)
 {
+    if (!overlay_enabled())
+        return;
     P.acc[phase] += now() - P.t0[phase].QuadPart;
 }

@@ -73,7 +89,7 @@ static void init(void)
     P.inited = 1;
     QueryPerformanceFrequency(&P.freq);
     if (GetEnvironmentVariableA("RAGEXE_OVERLAY", buf, sizeof(buf)) && buf[0] && buf[0] != '0')
-        P.shown = 1;
+        P.enabled = P.shown = 1;
     P.lastScroll = GetKeyState(VK_SCROLL) & 1;
     P.start = now();
 }
@@ -157,8 +173,8 @@ void perf_frame_end(struct Renderer *r)
 {
     LONGLONG t;
     (void)r;
-    if (!P.inited)
-        init();
+    if (!overlay_enabled())
+        return;
     t = now();
     if (P.lastFrameEnd) {
         LONGLONG d = t - P.lastFrameEnd;
@@ -335,8 +351,9 @@ static void draw_overlay(struct Renderer *r)
 void perf_overlay_draw(struct Renderer *r)
 {
     int visible;
-    if (!P.inited)
-        init();
+    if (!overlay_enabled())
+        return;
+    /* With the overlay on, Scroll Lock hides and shows it. */
     visible = GetKeyState(VK_SCROLL) & 1;
     if (visible != P.lastScroll) {
         P.lastScroll = visible;
