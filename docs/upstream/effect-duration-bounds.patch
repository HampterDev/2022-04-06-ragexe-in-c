diff --git a/tests/extract_effect_launch_duration.py b/tests/extract_effect_launch_duration.py
new file mode 100644
index 0000000..3037a2a
--- /dev/null
+++ b/tests/extract_effect_launch_duration.py
@@ -0,0 +1,16 @@
+"""Extract rag_effect_init (with its file prefix) so its duration lookup can run alone."""
+from pathlib import Path
+import re
+import sys
+
+root, output = map(Path, sys.argv[1:])
+source = (root / 'src/effects/rag/rag_str_anim.c').read_text(encoding='utf-8')
+prefix_end = source.index('\nstatic int roll(')
+parts = [source[:prefix_end]]
+for signature in ['static int roll(', 'void rag_effect_init(']:
+    matches = list(re.finditer(r'^' + re.escape(signature) + r'[^{]*\n\{', source, re.M))
+    assert len(matches) == 1, signature
+    start = matches[0].start()
+    parts.append(source[start:source.index('\n}', start) + 2])
+output.mkdir(parents=True, exist_ok=True)
+(output / 'effect_launch_duration.inc').write_text('\n\n'.join(parts) + '\n', encoding='utf-8')
diff --git a/tests/test_effect_launch_duration.c b/tests/test_effect_launch_duration.c
new file mode 100644
index 0000000..9e2acf6
--- /dev/null
+++ b/tests/test_effect_launch_duration.c
@@ -0,0 +1,56 @@
+#include "effect_launch_duration.inc"
+
+#include <assert.h>
+#include <stdio.h>
+
+/* Run the production rag_effect_init against the real duration table. Server
+   effect IDs reach it up to 60000; the table has EFFECT_DURATION_COUNT rows. */
+struct Session g_session1;
+static struct RagEffect effect;
+static int set_calls, last_duration, cases;
+static char loaded[64];
+
+void rag_effect_set_duration(struct RagEffect *self, int frame)
+{
+    assert(self == &effect);
+    last_duration = frame;
+    ++set_calls;
+}
+
+void rag_str_load(struct RagEffect *self, const char *name)
+{
+    assert(self == &effect && strlen(name) < sizeof loaded);
+    strcpy(loaded, name);
+}
+
+static void check(int id, int duration, const char *file)
+{
+    struct RenderObject master;
+    Vec3 offset = { 1.0f, 2.0f, 3.0f };
+    int previous = set_calls;
+
+    memset(&effect, 0, sizeof effect);
+    memset(&master, 0, sizeof master);
+    loaded[0] = 0;
+    rag_effect_init(&effect, &master, id, offset);
+    assert(set_calls == previous + 1 && effect.effect_id == id && effect.master == &master);
+    assert(last_duration == duration);
+    assert(strcmp(loaded, file) == 0);
+    ++cases;
+}
+
+int main(void)
+{
+    assert(EFFECT_DURATION_COUNT == 2385);
+    check(0, 50, "");
+    check(13, 9999, "SafetyWall.str");
+    check(2340, 2340, "");
+    check(2383, 9999, "");
+    check(2384, 0, "");
+    check(2385, 2385, "");
+    check(2386, 2386, "");
+    check(30000, 30000, "");
+    check(60000, 60000, "");
+    printf("Effect launch duration: %d cases passed (table rows in range; IDs past it last their ID).\n", cases);
+    return 0;
+}
