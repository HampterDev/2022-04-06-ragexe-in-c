+++ b/src/effects/rag/rag_unreferenced.c
@@ -240,10 +240,11 @@ unsigned char rag_meteor_storm_waves(struct RagEffect *self)
     switch (self->frame) {
     case 0:
         rag_play_wave_here(self, "effect\\wizard_meteo.wav");
