From 1d3102650c7aea72a6b13c3e6f345c5059cb1503 Mon Sep 17 00:00:00 2001
From: HampterDev <131729366+HampterDev@users.noreply.github.com>
Date: Tue, 3 Nov 2026 17:28:24 +0100
Subject: [PATCH] Read private-airplane map names only from their 16-byte field

The private-airplane moves take the map name from the 16-byte field of
ZC_MAPMOVE_PRIVATE_AIRPLANE and ZC_SERVERMOVE_PRIVATE_AIRPLANE, which
need not end in a NUL. game_mode_on_map_move_private_airplane copied it
with strcpy_s into the 16-byte field of the ZC_NPCACK_MAPMOVE it builds,
so a full field (or one without a NUL) made strcpy_s end the client.
game_mode_on_server_move_private_airplane read it with
string_assign_cstr, past a full field.

The map move now copies field to field with strncpy, so a full name
fills the field without a NUL, as a ZC_NPCACK_MAPMOVE from the server
does, and game_mode_zc_npcack_mapmove reads it as before. The server
move takes at most 16 bytes (AIRPLANE_MAP_NAME) with strnlen.

Validation: the new test_private_airplane runs both extracted functions
on fields followed by 'Z' bytes: prontera.gat, a name without the
extension, the empty name, 15 bytes and a full 16 bytes. The map move
must pass the name as game_mode_zc_npcack_mapmove reads it, with the
packet ID and coordinates, and the server move must pass exactly the
name. The test ends at strcpy_s on the previous code and fails with
only the server move reverted. Release build without warnings.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01VaQB81YtRGLtH8zvfX7WTY
---
 src/game/private_airplane.c       |  9 +++-
 tests/build.bat                   |  3 ++
 tests/build_private_airplane.bat  | 15 ++++++
 tests/extract_private_airplane.py | 30 +++++++++++
 tests/test_private_airplane.c     | 84 +++++++++++++++++++++++++++++++
 5 files changed, 139 insertions(+), 2 deletions(-)
 create mode 100644 tests/build_private_airplane.bat
 create mode 100644 tests/extract_private_airplane.py
 create mode 100644 tests/test_private_airplane.c

diff --git a/src/game/private_airplane.c b/src/game/private_airplane.c
index 2d4d317..ba055bc 100644
--- a/src/game/private_airplane.c
+++ b/src/game/private_airplane.c
@@ -16,6 +16,10 @@ struct PacketNpcAckMapMove {
 #pragma pack(pop)
 enum { HEADER_ZC_NPCACK_MAPMOVE = 0x91 };

+/* map_name is the 16-byte field of ZC_MAPMOVE_PRIVATE_AIRPLANE and
+   ZC_SERVERMOVE_PRIVATE_AIRPLANE; a full field has no NUL. */
+#define AIRPLANE_MAP_NAME 16
+
 void game_mode_on_map_move_private_airplane(struct GameMode *self, const char *map_name,
                                                  unsigned short x, unsigned short y)
 {
@@ -23,7 +27,8 @@ void game_mode_on_map_move_private_airplane(struct GameMode *self, const char *m

     g_session1.loadingAirplane = 1;
     move.packet_type = HEADER_ZC_NPCACK_MAPMOVE;
-    strcpy_s(move.map_name, sizeof move.map_name, map_name);
+    /* Field to field, as ZC_NPCACK_MAPMOVE carries it: a full name fills it without a NUL. */
+    strncpy(move.map_name, map_name, sizeof move.map_name);
     move.x = x;
     move.y = y;
     game_mode_zc_npcack_mapmove(self, (const unsigned char *)&move);
@@ -37,7 +42,7 @@ void game_mode_on_server_move_private_airplane(struct GameMode *self, const char
     g_session1.loadingAirplane = 1;
     string_init(&extra);
     string_init(&map);
-    string_assign_cstr(&map, map_name);
+    string_assign(&map, map_name, strnlen(map_name, AIRPLANE_MAP_NAME));
     game_mode_move_to_server(self, map, x, y, ip, port, extra);
 }

