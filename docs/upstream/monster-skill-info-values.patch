diff --git a/tests/extract_monster_skill_info.py b/tests/extract_monster_skill_info.py
new file mode 100644
index 0000000..f039004
--- /dev/null
+++ b/tests/extract_monster_skill_info.py
@@ -0,0 +1,30 @@
+"""Extract session_get_monster_skill_info with its static helpers from talk_tables.c,
+and the Korean-service text mirror from msg_str.c."""
+from pathlib import Path
+import re
+import sys
+
+root, output = map(Path, sys.argv[1:])
+
+
+def functions(source, signatures, optional=()):
+    parts = []
+    for signature in signatures:
+        matches = list(re.finditer(r'^' + re.escape(signature) + r'[^{;]*\n\{', source, re.M))
+        if not matches and signature in optional:
+            continue
+        assert len(matches) == 1, signature
+        start = matches[0].start()
+        parts.append(source[start:source.index('\n}', start) + 2])
+    return parts
+
+
+talk = (root / 'src/session/talk_tables.c').read_text(encoding='utf-8')
+parts = functions(talk, ['static char *node_text(', 'static int node_number(',
+                         'void session_get_monster_skill_info('],
+                  optional=('static int node_number(',))
+mirror = functions((root / 'src/core/msg_str.c').read_text(encoding='utf-8'),
+                   ['static char *text_decode_mirror('])
+output.mkdir(parents=True, exist_ok=True)
+(output / 'monster_skill_info.inc').write_text('\n\n'.join(parts) + '\n', encoding='utf-8')
+(output / 'text_mirror.inc').write_text('\n\n'.join(mirror) + '\n', encoding='utf-8')
diff --git a/tests/test_monster_skill_info.c b/tests/test_monster_skill_info.c
new file mode 100644
index 0000000..9937f7c
--- /dev/null
+++ b/tests/test_monster_skill_info.c
@@ -0,0 +1,148 @@
+#include <assert.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include "core/msg_str.h"
+#include "core/xml.h"
+#include "session/session_state.h"
+#include "session/state.h"
+#include "ui/window_manager_state.h"
+#include "ui/window_messages.h"
+
+/* Run the production session_get_monster_skill_info over a parsed
+   monsterskillinfo.xml. Values longer than 8 bytes, values with printf
+   conversions, missing <action> or <loopType> nodes and monster names longer
+   than its 0x100-byte buffer must be read without overrunning anything, with
+   the tags stored plain and, as for the Korean service, mirrored. */
+
+struct Session g_session1;
+struct UIWindowMgr g_windowMgr;
+static int korean, admin, boxes;
+
+__declspec(noreturn) void fatal_error(const char *message) { (void)message; abort(); }
+
+#include "text_mirror.inc"
+
+char *text_decode(char *text)
+{
+    return korean ? text_decode_mirror(text) : text;
+}
+
+int session_is_admin_option(struct Session *self, int what)
+{
+    assert(self == &g_session1 && what == 1);
+    return admin;
+}
+
+int ui_window_mgr_message_box(struct UIWindowMgr *self, const char *text, int type, int arg3, int arg4, int arg5,
+                              const char *title, int width, int height, int arg9)
+{
+    assert(self == &g_windowMgr && text && title);
+    (void)type; (void)arg3; (void)arg4; (void)arg5; (void)width; (void)height; (void)arg9;
+    ++boxes;
+    return 0;
+}
+
+#include "monster_skill_info.inc"
+
+/* Append "<tag>" or "</tag>", the tag mirrored for the Korean service. */
+static void tag(char *xml, const char *name, int close)
+{
+    char stored[64];
+
+    assert(strlen(name) < sizeof stored);
+    strcpy(stored, name);
+    if (korean)
+        text_decode_mirror(stored);
+    strcat(xml, close ? "</" : "<");
+    strcat(xml, stored);
+    strcat(xml, ">");
+}
+
+static void element(char *xml, const char *name, const char *value)
+{
+    tag(xml, name, 0);
+    strcat(xml, value);
+    tag(xml, name, 1);
+}
+
+static void skill(char *xml, const char *key, const char *action, const char *loop)
+{
+    tag(xml, key, 0);
+    if (action)
+        element(xml, "action", action);
+    if (loop)
+        element(xml, "loopType", loop);
+    tag(xml, key, 1);
+}
+
+static void load(void)
+{
+    static char xml[2048];
+
+    xml[0] = 0;
+    tag(xml, "Monster_Action_Table", 0);
+    tag(xml, "poring", 0);
+    skill(xml, "_10", "3", "1");
+    skill(xml, "_11", "000000000007", "  -2 and some text after it");
+    skill(xml, "_12", "5%d%s%n", "%n9");
+    skill(xml, "_13", "4", NULL);
+    skill(xml, "_14", NULL, "1");
+    skill(xml, "_15", NULL, NULL);
+    skill(xml, "_16", "", "");
+    tag(xml, "poring", 1);
+    tag(xml, "Monster_Action_Table", 1);
+    xml_element_construct(&g_session1.monsterSkillTable.root, "XMLDocument");
+    g_session1.monsterSkillTable.copy = NULL;
+    assert(xml_parse(&g_session1.monsterSkillTable, xml, xml + strlen(xml)));
+}
+
+static void unload(void)
+{
+    xml_document_release(&g_session1.monsterSkillTable);
+    xml_element_destruct(&g_session1.monsterSkillTable.root);
+}
+
+static int cases;
+
+static void check(const char *monster, int skill_id, int action, int loop, int message_boxes)
+{
+    int got_action = 0x55, got_loop = 0x66;
+
+    boxes = 0;
+    session_get_monster_skill_info(&g_session1, monster, skill_id, &got_action, &got_loop);
+    assert(got_action == action && got_loop == loop && boxes == message_boxes);
+    ++cases;
+}
+
+int main(void)
+{
+    char long_name[0x300];
+
+    memset(long_name, 'p', sizeof long_name - 1);
+    long_name[sizeof long_name - 1] = 0;
+    for (korean = 0; korean < 2; ++korean) {
+        load();
+        admin = 0;
+        check("poring", 10, 3, 1, 0);
+        check("PORING", 10, 3, 1, 0);
+        check("poring", 11, 7, -2, 0);
+        check("poring", 12, 5, 0, 0);
+        check("poring", 13, 4, 0, 0);
+        check("poring", 14, 0, 1, 0);
+        check("poring", 15, 0, 0, 0);
+        check("poring", 16, 0, 0, 0);
+        check("poring", 99, -1, 0x66, 0);
+        check("lunatic", 10, -1, 0x66, 0);
+        check(long_name, 10, -1, 0x66, 0);
+        check("poring", 10, 3, 1, 0);
+        admin = 1;
+        check("poring", 10, 3, 1, 0);
+        check("poring", 13, 0, 0, 2);
+        check("poring", 14, 0, 0, 2);
+        check("poring", 11, 7, -2, 0);
+        unload();
+    }
+    printf("Monster skill info: %d lookups; long, formatted and missing values and long names.\n", cases);
+    return 0;
+}
