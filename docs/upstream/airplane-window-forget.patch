diff --git a/tests/extract_airplane_window_slot.py b/tests/extract_airplane_window_slot.py
new file mode 100644
index 0000000..9b213e7
--- /dev/null
+++ b/tests/extract_airplane_window_slot.py
@@ -0,0 +1,40 @@
+"""Extract the private-airplane window slot handling and what destroys the window.
+
+From navigation_cmd.c the statements that keep the window in g_windowMgr.private_airplane_wnd
+around its modal loop; from modal.c the modal loop; from window_base.c ui_window_destruct.
+Usage: ROOT OUT"""
+import re
+import sys
+from pathlib import Path
+
+root, out = Path(sys.argv[1]) / 'src', Path(sys.argv[2])
+out.mkdir(parents=True, exist_ok=True)
+
+
+def read(name):
+    return (root / name).read_bytes().decode('utf-8').replace('\r\n', '\n')
+
+
+def function(text, pattern, name):
+    match = re.search(r'^' + pattern + r'\([^)]*\)\n\{\n.*?^\}\n', text, re.M | re.S)
+    if not match:
+        sys.exit(name + ' not found')
+    return match.group(0)
+
+
+navigation = read('ui/quests/navigation_cmd.c')
+closed = re.search(r'^#define AIRPLANE_RESULT_CLOSED .*\n', navigation, re.M)
+slot = re.search(r'^    g_windowMgr\.private_airplane_wnd = wnd;\n(?:    .*\n)*?        g_windowMgr\.private_airplane_wnd = NULL;\n',
+                 navigation, re.M)
+if not closed or not slot:
+    sys.exit('airplane slot statements not found')
+modal = read('ui/wndmgr/modal.c')
+parts = [
+    closed.group(0),
+    'static void open_airship_slot(struct UIWindow *wnd)\n{\n' + slot.group(0) + '}\n',
+    function(modal, r'int ui_window_mgr_modal_loop', 'ui_window_mgr_modal_loop'),
+    function(modal, r'static int run_modal', 'run_modal'),
+    function(modal, r'int ui_window_mgr_do_modal', 'ui_window_mgr_do_modal'),
+    function(read('ui/controls/window_base.c'), r'void ui_window_destruct', 'ui_window_destruct'),
+]
+(out / 'airplane_window_slot.inc').write_text('\n'.join(parts), encoding='utf-8')
diff --git a/tests/test_airplane_window_slot.c b/tests/test_airplane_window_slot.c
new file mode 100644
index 0000000..ad031f9
--- /dev/null
+++ b/tests/test_airplane_window_slot.c
@@ -0,0 +1,110 @@
+/* The private-airplane window slot. navigation_cmd.c keeps the window in
+   g_windowMgr.private_airplane_wnd for its modal loop and clears the slot only when the loop ends
+   with AIRPLANE_RESULT_CLOSED (0xb4). A flight ends it with 0xb1 instead: the airplane map move
+   (game_mode_zc_npcack_mapmove) sets that result. The loop then posts the window to the quit
+   list, and its destruction (ui_window_destruct -> ui_window_mgr_forget_window) must clear the
+   slot, or the slot points at the freed window. */
+#include "ui/window_manager_state.h"
+#include "ui/window_mgr.h"
+#include "ui/wndmgr/wndmgr.h"
+#include "world/mode_dispatch.h"
+#include "world/mode_manager.h"
+#include "core/app.h"
+#include "core/object_type_tables.h"
+#include "render/cdc.h"
+#include "render/surface.h"
+#include "render/texture.h"
+#include "std/list.h"
+#include "std/vec.h"
+#include <assert.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#define MODAL_RESULT_FLIGHT 0xb1 /* game_mode_zc_npcack_mapmove, packets_npc.c */
+
+struct UIWindowMgr g_windowMgr;
+int g_quitRequested;
+
+void *mem_alloc(size_t bytes)
+{
+    void *p = calloc(1, bytes);
+    assert(p);
+    return p;
+}
+void mem_free(void *p) { free(p); }
+void actors_forget_window(const struct UIWindow *wnd) { (void)wnd; }
+void ui_window_mgr_remove_from_name_waiting_list(struct UIWindowMgr *self, struct UIWindow *wnd)
+{ (void)self; (void)wnd; }
+void dc_bitmap_destroy(struct DcBitmap *self) { (void)self; abort(); }
+void surface_destroy(struct Surface *surface) { (void)surface; abort(); }
+void vec_free(struct Vec *v)
+{
+    free(v->first);
+    memset(v, 0, sizeof *v);
+}
+struct UIWindow *ui_window_get_ancestor(struct UIWindow *self) { return self; }
+void ui_window_mgr_focus_first_edit(struct UIWindowMgr *self) { (void)self; }
+struct Mode *client_current_mode(void) { return NULL; }
+
+/* The quit list: the window is destroyed after the loop, as destroy_closed_windows does. */
+static struct UIWindow *quitting;
+void ui_window_mgr_post_quit2(struct UIWindowMgr *self, struct UIWindow *wnd)
+{
+    assert(self == &g_windowMgr && !quitting);
+    quitting = wnd;
+}
+
+/* One frame: the server's answer arrives. */
+static int frame_result, frames;
+void mode_update(struct Mode *mode)
+{
+    (void)mode;
+    assert(g_windowMgr.private_airplane_wnd && g_windowMgr.modal_wnd == g_windowMgr.private_airplane_wnd);
+    frames++;
+    g_windowMgr.modal_result = frame_result;
+}
+
+static void on_destroy(struct UIWindow *self) { (void)self; }
+static int destroyed;
+static void airplane_destroy(struct UIWindow *self)
+{
+    ui_window_destruct(self);
+    destroyed++;
+    /* Not freed, so that a slot still holding it can be recognised. */
+}
+const struct UIWindowOps ui_window_ops = { .on_destroy = on_destroy };
+static const struct UIWindowOps airplane_ops = { .destroy = airplane_destroy, .on_destroy = on_destroy };
+
+void ui_window_destruct(struct UIWindow *self);
+#include "airplane_window_slot.inc"
+
+static void fly(int result, const char *what)
+{
+    static struct UIWindow window;
+
+    memset(&window, 0, sizeof window);
+    list_init(&window.draws);
+    list_init(&window.children);
+    window.ops = &airplane_ops;
+    quitting = NULL;
+    frames = destroyed = 0;
+    frame_result = result;
+
+    open_airship_slot(&window);
+    assert(frames == 1 && quitting == &window && !g_windowMgr.modal_wnd);
+    ui_window_destroy(quitting);
+    assert(destroyed == 1);
+    if (g_windowMgr.private_airplane_wnd) {
+        printf("%s: private_airplane_wnd still points at the destroyed window\n", what);
+        exit(1);
+    }
+}
+
+int main(void)
+{
+    fly(AIRPLANE_RESULT_CLOSED, "closed");
+    fly(MODAL_RESULT_FLIGHT, "flight");
+    puts("Airplane window slot: cleared when the window is destroyed after its modal loop ends by closing (0xb4) or by the flight's map move (0xb1).");
+    return 0;
+}
