 tests/build.bat                        |  3 +
 tests/build_lapine_upgrade_result.bat  | 15 +++++
 tests/extract_lapine_upgrade_result.py | 17 ++++++
 tests/test_lapine_upgrade_result.c     | 80 ++++++++++++++++++++++++++
 5 files changed, 116 insertions(+), 1 deletion(-)
