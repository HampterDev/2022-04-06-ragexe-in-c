@@ -33,8 +33,7 @@ void login_mode_enter_zone(struct LoginMode *self, DWORD gid,
         ui_window_mgr_post_quit2(&g_windowMgr, g_windowMgr.new_select_char_wnd);

     string_copy(&map, &mapName);
