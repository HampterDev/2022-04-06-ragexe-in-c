     addr.s_addr = ip;
diff --git a/tests/extract_name_text.py b/tests/extract_name_text.py
index 7491ba2..5d00e28 100644
--- a/tests/extract_name_text.py
+++ b/tests/extract_name_text.py
@@ -81,6 +81,13 @@ def region(source, first, last):
     return source[start:source.index(tail, start) + len(tail)]


+def lines_until(source, first, stop):
+    """From the line that matches first up to the next line that matches stop."""
+    start = source.rindex('\n', 0, unique(source, first).start()) + 1
+    end = re.compile(stop, re.M).search(source, start)
+    return source[start:end.start()].rstrip() + '\n'
+
+
 def case(source, label):
     start = unique(source, r'^[ \t]*case ' + re.escape(label) + r':[ \t]*$').start()
     end = source.index('break;', start)
@@ -109,6 +116,11 @@ pieces['server_list'] = (optional_function(login, 'static void server_line(') +
                          [function(login, 'static void server_list(')])
 pieces['map_name'] = [region(read('game/mode_connection.c'), r'string_copy\(&name, &map_name\);',
                              r'\(\*\(char \(\*\)\[20\]\)&g_session1\.mapName\)')]
+pieces['map_helper'] = optional_function(read('core/text_util.c'), 'void text_drop_map_extension(')
+pieces['mapmove_name'] = [lines_until(read('game/packets_npc.c'), r'string_assign_cstr\(&map, name_buf\);',
+                                      r'^\s*if \(')]
+pieces['zone_name'] = [region(read('login/zone.c'), r'string_copy\(&map, &mapName\);',
+                              r'strcpy\(g_session1\.mapName, string_cstr\(&map\)\);')]
 homun = read('ui/character/companion_info.c')
 pieces['homun_default'] = [statement(homun, r'if \(strcmp\(g_session1\.homunName, ""\) == 0\)')]
 pieces['homun_rename'] = [statement(homun, r'\w+\(g_session1\.homunName,[^;]*ui_edit_ctrl_get_text\(self->name_edit\)')]
diff --git a/tests/test_name_text.c b/tests/test_name_text.c
index 962bb4e..1d8d6db 100644
--- a/tests/test_name_text.c
+++ b/tests/test_name_text.c
@@ -109,6 +109,7 @@ static void default_wallpaper(struct LoginMode *self) { (void)self; }
 #include "name_text_couple_name.inc"
 #include "name_text_cut_in.inc"
 #include "name_text_server_list.inc"
+#include "name_text_map_helper.inc"

 /* The map name from a server-move packet, with its .gat extension. */
 static void map_name(const char *text)
@@ -122,6 +123,39 @@ static void map_name(const char *text)
     string_free(&map_name);
 }

+/* The map name from ZC_NPCACK_MAPMOVE, as game_mode_zc_npcack_mapmove takes it from
+   its 16-byte field. The previous code also used shorter. */
+static void mapmove_name(const char *text, char *out, size_t size)
+{
+    char name_buf[17];
+    struct String map;
+    unsigned shorter = 0;
+
+    (void)shorter;
+    memset(name_buf, 0, sizeof name_buf);
+    strncpy(name_buf, text, 16);
+    string_init(&map);
+#include "name_text_mapmove_name.inc"
+    assert(map.size < size);
+    strcpy(out, string_cstr(&map));
+    string_free(&map);
+}
+
+/* The map name from HC_NOTIFY_ZONESVR in login_mode_enter_zone. The previous code also
+   used len. */
+static void zone_name(const char *text)
+{
+    struct String mapName, map;
+    size_t len = 0;
+
+    (void)len;
+    string_init(&mapName);
+    string_assign_cstr(&mapName, text);
+#include "name_text_zone_name.inc"
+    string_free(&map);
+    string_free(&mapName);
+}
+
 static void homun_default(void)
 {
 #include "name_text_homun_default.inc"
@@ -371,6 +405,23 @@ static void check_map_name(void)
     check(whole, "a");
     map_name("");
     check(whole, "");
+
+    /* The same at the other two places that drop the extension. */
+    {
+        static const char *const names[][2] = {
+            { "prontera.gat", "prontera" }, { "abcdefghijkl.gat", "abcdefghijkl" },
+            { "x.gat", "x" }, { ".gat", "" }, { "abc", "abc" }, { "a", "a" }, { "", "" },
+        };
+        char moved[0x20];
+        size_t i;
+
+        for (i = 0; i < sizeof names / sizeof *names; ++i) {
+            mapmove_name(names[i][0], moved, sizeof moved);
+            check(moved, names[i][1]);
+            zone_name(names[i][0]);
+            check(whole, names[i][1]);
+        }
+    }
 }

 static void check_typed_names(void)
