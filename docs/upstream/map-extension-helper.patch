From 9443627d108cad1894173aa5183fb6abd7d8c3c0 Mon Sep 17 00:00:00 2001
From: HampterDev <131729366+HampterDev@users.noreply.github.com>
Date: Tue, 3 Nov 2026 17:24:02 +0100
Subject: [PATCH] Keep short map names at every place that drops the extension

game_mode_zc_npcack_mapmove (packets_npc.c, ZC_NPCACK_MAPMOVE and the
private-airplane map move) and login_mode_enter_zone (zone.c,
HC_NOTIFY_ZONESVR) drop the .gat of the map name as
game_mode_move_to_server did before f41fb0b: string_resize to the size
minus 4, which wraps for a name shorter than 4 bytes and makes
string_resize end the client with "string too long".

text_drop_map_extension (core/text_util.c) now does it for all three:
it drops the last 4 bytes of a name of 4 bytes or more and keeps a
shorter one. game_mode_move_to_server uses it in place of its own check.

Validation: test_name_text now also runs the name handling of
game_mode_zc_npcack_mapmove from its 16-byte field and of
login_mode_enter_zone through the copy into mapName, with the helper,
on prontera.gat, a full 16-byte name, x.gat, .gat, abc, a and the empty
name. 71 cases. The test ends in fatal_error on the previous code and
with either of the two files reverted. Release build without warnings.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01VaQB81YtRGLtH8zvfX7WTY
---
 src/core/text_util.c       |  6 +++++
 src/core/text_util.h       |  4 +++
 src/game/mode_connection.c |  6 ++---
 src/game/packets_npc.c     |  5 ++--
 src/login/zone.c           |  5 ++--
 tests/extract_name_text.py | 12 +++++++++
 tests/test_name_text.c     | 51 ++++++++++++++++++++++++++++++++++++++
 7 files changed, 79 insertions(+), 10 deletions(-)

diff --git a/src/core/text_util.c b/src/core/text_util.c
index f04dd99..fcdf055 100644
--- a/src/core/text_util.c
+++ b/src/core/text_util.c
@@ -120,6 +120,12 @@ void text_to_lower(struct String *s)
     }
 }

+void text_drop_map_extension(struct String *map_name)
+{
+    if (map_name->size >= 4)
+        string_truncate(map_name, map_name->size - 4);
+}
+
 char *str_find_last(char *text, char c)
 {
     char *at;
diff --git a/src/core/text_util.h b/src/core/text_util.h
index 553b91d..ae8128a 100644
--- a/src/core/text_util.h
+++ b/src/core/text_util.h
@@ -13,6 +13,10 @@ void tokens_split(struct Vec *tokens, const struct String *line);

 void text_to_lower(struct String *s);

+/* Drops the 4-byte extension (.gat) that servers append to a map name. A name shorter
+   than 4 bytes cannot carry one and is kept as it is. */
+void text_drop_map_extension(struct String *map_name);
+
 char *str_find_last(char *text, char c);

 #endif
diff --git a/src/game/mode_connection.c b/src/game/mode_connection.c
index b8a05a6..ebdea7f 100644
--- a/src/game/mode_connection.c
+++ b/src/game/mode_connection.c
@@ -34,6 +34,7 @@
 #include "ui/ui_std.h"
 #include "ui/wndmgr/wndmgr.h"
 #include "core/app.h"
+#include "core/text_util.h"
 #include "login/zone.h"

 static unsigned int g_keepAliveInterval = 12000u;
@@ -166,10 +167,7 @@ void game_mode_move_to_server(struct GameMode *self, struct String map_name, int
     session_clear_party_members(&g_session1);

     string_copy(&name, &map_name);
-    /* Servers send <map>.gat: drop the 4-byte extension. A shorter name has none to drop
-       and is kept; size - 4 would wrap and make string_resize end the client. */
-    if (name.size >= 4)
-        string_resize(&name, name.size - 4, 0);
+    text_drop_map_extension(&name);
     _snprintf_s((*(char (*)[20])&g_session1.mapName), 0x14, _TRUNCATE, "%s", string_cstr(&name));
     g_session1.playerPosX = x;
     g_session1.playerPosY = y;
diff --git a/src/game/packets_npc.c b/src/game/packets_npc.c
index d8e3fb4..5be35ca 100644
--- a/src/game/packets_npc.c
+++ b/src/game/packets_npc.c
@@ -12,6 +12,7 @@
 #include "session/state.h"
