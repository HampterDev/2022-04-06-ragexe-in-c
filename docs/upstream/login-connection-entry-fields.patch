+if not "%errorlevel%"=="0" exit /b 1
diff --git a/tests/build_login_conn_entry.bat b/tests/build_login_conn_entry.bat
new file mode 100644
index 0000000..332563c
--- /dev/null
+++ b/tests/build_login_conn_entry.bat
@@ -0,0 +1,14 @@
