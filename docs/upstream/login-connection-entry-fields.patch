From d28b5abd09104596bd9ff654209c34a118cd1468 Mon Sep 17 00:00:00 2001
From: HampterDev <131729366+HampterDev@users.noreply.github.com>
Date: Tue, 3 Nov 2026 14:43:40 +0100
Subject: [PATCH] Zero the unused version and service type of login connection
 entries

login_conn_entry_copy copies LoginConnEntry.version and service_type,
which nothing sets: login_conn_entry_construct initializes only the five
strings, and login_mode_load_connections builds its entries with five
string_init calls instead of the constructor. Every entry pushed by
push_copy therefore copied two uninitialized stack values. Nothing reads
either field; the login packets send g_clientVersion.

login_conn_entry_construct now sets both fields to 0, and
login_mode_load_connections builds its entry with it; the constructor
makes the same five string_init calls.

Validation: the new test_login_conn_entry fills the stack with a pattern
and loads the connection list and both subconnection lists of a parsed
clientinfo.xml through the production login_std.c and connections.c;
every entry, and an entry constructed over a filled struct and its copy,
must have both fields 0. The test fails on the previous code, and with
only the constructor changed. Release build without warnings.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01VaQB81YtRGLtH8zvfX7WTY
---
 src/login/connections.c          |   6 +-
 src/login/login_std.c            |   2 +
 tests/build.bat                  |   3 +
 tests/build_login_conn_entry.bat |  14 ++++
 tests/test_login_conn_entry.c    | 107 +++++++++++++++++++++++++++++++
 5 files changed, 127 insertions(+), 5 deletions(-)
 create mode 100644 tests/build_login_conn_entry.bat
 create mode 100644 tests/test_login_conn_entry.c

diff --git a/src/login/connections.c b/src/login/connections.c
index 188b15f..d5f9707 100644
--- a/src/login/connections.c
+++ b/src/login/connections.c
@@ -91,11 +91,7 @@ BYTE login_mode_load_connections(struct LoginMode *self)
         if (!conn)
             return 0;
         do {
-            string_init(&e.display);
-            string_init(&e.desc);
-            string_init(&e.balloon);
-            string_init(&e.address);
-            string_init(&e.port);
+            login_conn_entry_construct(&e);
             read_text(conn, "display", &e.display);
             read_text(conn, "desc", &e.desc);
             read_text(conn, "balloon", &e.balloon);
diff --git a/src/login/login_std.c b/src/login/login_std.c
index 80a7954..b2836b0 100644
--- a/src/login/login_std.c
+++ b/src/login/login_std.c
@@ -13,6 +13,8 @@ struct LoginConnEntry *login_conn_entry_construct(struct LoginConnEntry *self)
     string_init(&self->balloon);
     string_init(&self->address);
     string_init(&self->port);
+    self->version = 0;
+    self->service_type = 0;
     return self;
 }

diff --git a/tests/build.bat b/tests/build.bat
index 71cb90e..16747f2 100644
--- a/tests/build.bat
+++ b/tests/build.bat
@@ -868,3 +868,6 @@ if not "%errorlevel%"=="0" exit /b 1

 call "%~dp0build_face_charset.bat"
 if not "%errorlevel%"=="0" exit /b 1
