From 7fe9620febaabe966c9ddf1356e4f5ab1b9bd144 Mon Sep 17 00:00:00 2001
From: HampterDev <131729366+HampterDev@users.noreply.github.com>
Date: Sun, 1 Nov 2026 11:26:53 +0100
Subject: [PATCH] Use the shared cache filename for legacy guild emblems

---
 src/session/session_state.c     |  9 +++-
 tests/build.bat                 |  3 ++
 tests/build_emblem_cache.bat    | 13 +++++
 tests/emblem_cache_boundaries.h | 11 +++++
 tests/test_emblem_cache.c       | 84 +++++++++++++++++++++++++++++++++
 5 files changed, 119 insertions(+), 1 deletion(-)
 create mode 100644 tests/build_emblem_cache.bat
 create mode 100644 tests/emblem_cache_boundaries.h
 create mode 100644 tests/test_emblem_cache.c

diff --git a/src/session/session_state.c b/src/session/session_state.c
index df40039..9830636 100644
--- a/src/session/session_state.c
+++ b/src/session/session_state.c
@@ -1,6 +1,7 @@
 #include "render/renderer.h"
 #include "session/character_name.h"
 #include "contents/guild_info.h"
+#include "contents/guild_emblem_name.h"
 #include "session/csession.h"
 #include "session/session_jobs.h"
 #include "session/session_names.h"
@@ -306,7 +307,13 @@ void session_save_emblem(struct Session *self, const void *data, size_t size,
         _chmod(name, 0x80);
         _unlink(name);
     }
-    sprintf(path, "%s%s_%d_%d.ebm", dir, string_cstr(&self->worldName), guildId, version);
+    {
+        struct String name;
+
+        guild_emblem_name(&name, &self->worldName, (unsigned)guildId, version);
+        snprintf(path, sizeof path, "%s%s", dir, string_cstr(&name));
+        string_free(&name);
+    }
     f = fopen(path, "wb");
     if (f) {
         fwrite(data, size, 1, f);
diff --git a/tests/build.bat b/tests/build.bat
index 8b7c039..577defb 100644
--- a/tests/build.bat
+++ b/tests/build.bat
@@ -819,3 +819,6 @@ if not "%errorlevel%"=="0" (popd & exit /b 1)
 test_xml.exe
 if not "%errorlevel%"=="0" (popd & exit /b 1)
 popd
+
+call "%~dp0build_emblem_cache.bat"
+if errorlevel 1 exit /b 1
diff --git a/tests/build_emblem_cache.bat b/tests/build_emblem_cache.bat
new file mode 100644
index 0000000..afa3d8d
--- /dev/null
+++ b/tests/build_emblem_cache.bat
@@ -0,0 +1,13 @@
+@echo off
+setlocal
+set "ROOT=%~dp0.."
+call "%ROOT%\tools\find_vcvars.bat" || exit /b 1
+call "%VCVARS%" >nul
+if not exist "%ROOT%\build\tests\emblem_cache" mkdir "%ROOT%\build\tests\emblem_cache"
+pushd "%ROOT%\build\tests\emblem_cache" || exit /b 1
+cl /nologo /W3 /WX /O2 /Gy /Gw /MD /D_CRT_SECURE_NO_WARNINGS /source-charset:utf-8 /execution-charset:.949 /I"%ROOT%\src" /I"%ROOT%\vendor\lua-5.1.4\src" /I"%ROOT%\vendor\zlib-1.2.11" /I"%ROOT%\vendor\libpng-1.6.36" /I"%ROOT%\vendor\yyjson-0.13.0" /I"%ROOT%\vendor\giflib" /I"%ROOT%\vendor\curl-7.46.0\include" /FI"%ROOT%\tests\emblem_cache_boundaries.h" "%ROOT%\tests\test_emblem_cache.c" "%ROOT%\src\session\session_state.c" "%ROOT%\src\contents\guild_emblem_name.c" "%ROOT%\src\std\string.c" "%ROOT%\src\std\list.c" "%ROOT%\src\std\container_memory.c" "%ROOT%\src\std\vec.c" "%ROOT%\src\std\tree.c" winmm.lib /Fe:test_emblem_cache.exe /link /OPT:REF
+if not "%errorlevel%"=="0" (popd & exit /b 1)
+test_emblem_cache.exe
+if not "%errorlevel%"=="0" (popd & exit /b 1)
+popd
+exit /b 0
diff --git a/tests/emblem_cache_boundaries.h b/tests/emblem_cache_boundaries.h
new file mode 100644
index 0000000..7106d23
--- /dev/null
+++ b/tests/emblem_cache_boundaries.h
@@ -0,0 +1,11 @@
+#include <stdio.h>
+#include <io.h>
+#include <direct.h>
+int emblem_test_access(const char *path, int mode);
+FILE *emblem_test_open(const char *path, const char *mode);
+size_t emblem_test_write(const void *data, size_t size, size_t count, FILE *file);
+int emblem_test_close(FILE *file);
+#define _access emblem_test_access
+#define fopen emblem_test_open
+#define fwrite emblem_test_write
+#define fclose emblem_test_close
diff --git a/tests/test_emblem_cache.c b/tests/test_emblem_cache.c
new file mode 100644
index 0000000..5a31311
--- /dev/null
+++ b/tests/test_emblem_cache.c
@@ -0,0 +1,84 @@
+#include <assert.h>
+#include <limits.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include "session/state.h"
+#include "session/session_state.h"
+#include "contents/guild_info.h"
+#include "contents/guild_emblem_name.h"
+#include "contents/guild_emblem_api.h"
+#include "core/app.h"
+#include "core/file_util.h"
+#include "std/std.h"
+
+char g_clientDir[0x88] = "C:\\emblem-test";
+struct GuildInfo g_guildInfo;
+struct GuildMgr *g_guildMgr;
+static char opened[512];
+static unsigned writes, closes, updates;
+static int current_version;
+static const unsigned char payload[] = {0x78, 0x9c, 0, 0xff, 1};
+static FILE *const stream = (FILE *)1;
+struct Session g_session1;
+struct Renderer *g_renderer;
+int g_wobbleFramesLeft;
+BYTE g_wobbleMode;
+struct StoreSearchItem;
+const char *session_character_name(const struct Session *s) { (void)s; abort(); }
+int session_is_homunculus_skill(struct Session *s, int id) { (void)s; (void)id; abort(); }
+void session_refresh_basic_info(struct Session *s) { (void)s; abort(); }
+BYTE clientinfo_is_admin_aid(int aid) { (void)aid; abort(); }
+void store_search_items_destroy(struct StoreSearchItem *a, struct StoreSearchItem *b)
+{ (void)a; (void)b; abort(); }
+
+void *mem_alloc(size_t n) { void *p = malloc(n); assert(p); return p; }
+void mem_free(void *p) { free(p); }
+void fatal_error(const char *message) { (void)message; abort(); }
+int emblem_test_access(const char *path, int mode)
+{ assert(!strcmp(path, "C:\\emblem-test\\_tmpEmblem\\") && mode == 0); return 0; }
+FILE *emblem_test_open(const char *path, const char *mode)
+{ assert(!strcmp(mode, "wb")); strcpy(opened, path); return stream; }
+size_t emblem_test_write(const void *data, size_t size, size_t count, FILE *file)
+{
+    assert(file == stream && size == sizeof payload && count == 1);
+    assert(!memcmp(data, payload, size)); ++writes; return count;
+}
+int emblem_test_close(FILE *file) { assert(file == stream); ++closes; return 0; }
+void dir_list_names_list(struct List *files, const char *directory, const char *pattern)
+{
+    assert(files->size == 0 && !strcmp(directory, "C:\\emblem-test\\_tmpEmblem\\"));
+    assert(!strcmp(pattern, "world_7_*.ebm"));
+}
+void guild_mgr_set_emblem_version(struct GuildMgr *manager, unsigned guild, int version)
+{ assert(manager == g_guildMgr && guild == 7); ++updates; current_version = version; }
+
+int main(void)
+{
+    static struct Session session;
+    const int versions[] = {0, 1, INT_MAX, INT_MIN, -1};
+    unsigned i;
+    string_init(&session.worldName);
+    string_assign_cstr(&session.worldName, "world");
+    g_guildInfo.guild_id = 7;
+    for (i = 0; i < sizeof versions / sizeof versions[0]; ++i) {
+        struct String name;
+        char expected[512];
+        guild_emblem_name(&name, &session.worldName, 7, versions[i]);
+        snprintf(expected, sizeof expected, "%s\\_tmpEmblem\\%s", g_clientDir, string_cstr(&name));
+        session_save_emblem(&session, payload, sizeof payload, 7, versions[i]);
+        if (strcmp(opened, expected)) {
+            fprintf(stderr, "Cache name mismatch: wrote %s, lookup expects %s\n", opened, expected);
+            return 1;
+        }
+        assert(current_version == versions[i] && updates == i + 1);
+        assert(writes == i + 1 && closes == i + 1);
+        string_free(&name);
+    }
+    g_guildInfo.guild_id = 8;
+    session_save_emblem(&session, payload, sizeof payload, 7, 1);
+    assert(updates == 5 && writes == 6 && closes == 6);
+    string_free(&session.worldName);
+    puts("PASS: actual legacy emblem writer uses the lookup cache name across version boundaries, preserves payload bytes, cleanup and own-guild version updates.");
+    return 0;
+}
-- 
2.54.0.windows.1

