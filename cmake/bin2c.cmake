# cmake -DOUT=file.c -DNAME=symbol -DIN=data -P bin2c.cmake
# Writes what tools/bin2c.c writes for one file (`const unsigned char NAME[]` with the bytes and a
# terminating 0, `const size_t NAME_size`), for builds that cannot run a tool they compile.
file(READ "${IN}" hex HEX)
string(LENGTH "${hex}" digits)
math(EXPR count "${digits} / 2")
math(EXPR full "${count} / 16 * 32")
string(SUBSTRING "${hex}" 0 ${full} head)
string(SUBSTRING "${hex}" ${full} -1 tail)
set(byte "0x[0-9a-f][0-9a-f],")
string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," head "${head}")
string(REGEX REPLACE "(${byte}${byte}${byte}${byte}${byte}${byte}${byte}${byte}${byte}${byte}${byte}${byte}${byte}${byte}${byte}${byte})"
    "\n    \\1" head "${head}")
string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," tail "${tail}")
if(tail)
    set(tail "\n    ${tail} ")
else()
    set(tail "\n    ")
endif()
set(bytes "${head}${tail}")
string(REPLACE ",0x" ", 0x" bytes "${bytes}")
file(WRITE "${OUT}" "/* Generated by tools/bin2c.c; do not edit. */\n#include <stddef.h>\n\nconst unsigned char ${NAME}[] = {${bytes}0x00\n};\nconst size_t ${NAME}_size = ${count};\n")
